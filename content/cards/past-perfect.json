    {
      "title": "Past Perfect is used",
      "subtitle": "all cases and time expressions",
      "blocks": [
        {
          "kind": "uses",
          "items": [
            {
              "emoji": "\u23ea",
              "case": "for a past action which happened before another past action or before a stated past time",
              "examples": ["She <b>had already left</b> when I got home.", "She <b>had arrived</b> by 8 o'clock.", "He <b>had left</b> by the time I got there. (or by 8:15 pm)"]
            },
            {
              "emoji": "\ud83c\udfc6",
              "case": "for an action which finished in the past and whose result was visible in the past",
              "examples": ["He was happy. He <b>had won</b> the race.", "She was sad because she <b>had failed</b> the test."]
            },
            {
              "emoji": "\ud83d\udd01",
              "case": "as the past equivalent of Present Perfect",

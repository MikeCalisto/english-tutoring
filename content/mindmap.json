        "neg": "S + haven't / hasn't + V3",
        "que": "Have / Has + S + V3?"
      },
      "uses": [
        "past action, the time is not stated",
        "just finished action with a visible result",
        "life experience",
        "state that started in the past and still continues",
        "emphasis on number: how many"
      ],
      "time": [
        "just · already · yet · ever · never",
        "for · since · how long",
        "recently · lately · so far · this week"
      ],
      "spelling": [
        "regular verbs: V3 = V-ed (worked)",
        "irregular verbs: third form (gone, seen)"
      ]
    },

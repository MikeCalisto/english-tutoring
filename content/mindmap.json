    {
      "id": "present-simple",
      "title": "Present Simple",
      "group": "present",
      "side": "left",
      "form": {
        "pos": "S + V   (he / she / it: V-s)",
        "neg": "S + don't / doesn't + V",
        "que": "Do / Does + S + V?"
      },
      "uses": [
        "permanent situations and states",
        "habits and repeated actions",
        "general truths and laws of nature",
        "timetables and programmes",
        "commentaries, reviews, stories"

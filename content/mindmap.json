        "always · usually · often · sometimes · rarely · never",
        "every day / week / year",
        "on Mondays · in the morning · at night"
      ],
      "spelling": [
        "most verbs: + -s (works)",
        "-s, -ss, -sh, -ch, -x, -o: + -es (watches, goes)",
        "consonant + y: -ies (studies)"
      ]
    },
    {
      "id": "present-continuous",
      "title": "Present Continuous",
      "group": "present",
      "side": "left",
      "form": {
        "pos": "S + am / is / are + V-ing",
        "neg": "S + am not / isn't / aren't + V-ing",
        "que": "Am / Is / Are + S + V-ing?"
      },
      "uses": [
        "actions happening right now",
        "temporary situations",
        "fixed arrangements in the near future",
        "changing and developing situations",
        "always + an annoying habit"
      ],
      "time": [
        "now · right now · at the moment · at present",
        "today · tonight · this week · these days",
        "tomorrow · next week (for arrangements)"
      ],
      "spelling": [
        "most verbs: + -ing (working)",
        "-e: drop the e (making)",
        "short vowel + consonant: double it (running)",
        "-ie becomes -ying (lying)"
      ]
    },
    {
      "id": "present-perfect",
      "title": "Present Perfect",
      "group": "present",
      "side": "right",
      "form": {
